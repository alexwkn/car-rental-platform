# Copier ce fichier en .env puis adapter les valeurs :  cp .env.example .env

# --- Base de données PostgreSQL (conteneur "db") ---
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=locationvoiture
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://postgres:change_me@db:5432/locationvoiture

# --- Sécurité ---
# Générer une valeur aléatoire, par ex. :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_with_a_long_random_string
PEPPER=change_me_with_another_long_random_string

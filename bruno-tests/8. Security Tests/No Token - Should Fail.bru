meta {
  name: No Token - Should Fail
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/profiles
  body: none
  auth: none
}

tests {
  test("Access denied (401 no session, or 403 if a cookie from a previous test in this run is still attached)", function() {
    expect(res.getStatus()).to.be.oneOf([401, 403]);
  });

  test("Access denied without token", function() {
    const body = res.getBody();
    expect(body).to.not.be.empty;
  });
}

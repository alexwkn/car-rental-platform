meta {
  name: Login - Admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@mail.com",
    "password": "adminpass"
  }
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Response body is a non-empty JWT string", function() {
    expect(res.getBody()).to.be.a('string').and.not.empty;
  });
}

script:post-response {
  const token = res.getBody();
  if (res.getStatus() === 201 && token) {
    bru.setVar("token", token);
    console.log("✅ Token saved to environment:", token.substring(0, 20) + "...");
  } else {
    console.log("❌ No token in response");
  }
}

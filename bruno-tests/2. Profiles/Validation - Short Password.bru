meta {
  name: Validation - Short Password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/profiles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Invalid User",
    "email": "invalid@mail.com",
    "password": "short",
    "adress": "123 Street",
    "bank_account": "BE12345678901234",
    "is_renter": false
  }
}

tests {
  test("Status code is 422", function() {
    expect(res.getStatus()).to.equal(422);
  });
  
  test("Response has validation errors", function() {
    const body = res.getBody();
    expect(body).to.have.property('errors');
  });
}

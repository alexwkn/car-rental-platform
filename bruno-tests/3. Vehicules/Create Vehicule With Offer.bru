meta {
  name: Create Vehicule With Offer
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/vehicules/with-offer
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "vehicule": {
      "model": "Renault Clio",
      "licence_plate": "BRU-OFR-{{$randomInt}}",
      "description": "Vehicule created together with an offer"
    },
    "offer": {
      "start_date": "2026-03-01",
      "end_date": "2026-03-10",
      "fuel_level": 100,
      "adress": "Rue de Test 1, Namur",
      "price": 45.00,
      "description": "Test offer"
    }
  }
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Response has vehicule with a linked offer", function() {
    const body = res.getBody();
    expect(body.data).to.have.property('vehicule_id');
    expect(body.data.offer).to.be.an('array').with.lengthOf(1);
    expect(body.data.offer[0]).to.have.property('offer_id');
  });
}

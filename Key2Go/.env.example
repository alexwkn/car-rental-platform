# Copier ce fichier en Key2Go/.env :  cp Key2Go/.env.example Key2Go/.env
# Remplacer 192.168.x.x par l'adresse IP locale de votre ordinateur (ipconfig / ifconfig)
# "localhost" ne fonctionne pas depuis un téléphone physique.
EXPO_PUBLIC_BASE_API_ROUTE=http://192.168.x.x:3001
EXPO_PUBLIC_OFFER_ROUTE=/offers
EXPO_PUBLIC_LOGIN_ROUTE=/login
EXPO_PUBLIC_PROFILE_ROUTE=/profiles
EXPO_PUBLIC_ORDER_ROUTE=/orders
EXPO_PUBLIC_REVIEW_ROUTE=/reviews
EXPO_PUBLIC_VEHICULE_ROUTE=/vehicules
